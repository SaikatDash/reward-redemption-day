# API + Ollama server settings
HOST=0.0.0.0
PORT=8000
WEB_PORT=8000
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=qwen2.5:3b
AI_API_KEY=

# Replace with the exact origin shown by Netlify after deploying the frontend.
# Add a custom domain as another comma-separated origin if you use one.
ALLOWED_ORIGINS=https://your-site-name.netlify.app

# For a Netlify build, set this in Site configuration > Environment variables
# to the public HTTPS URL of the backend API, without a trailing slash.
VITE_API_BASE_URL=https://your-api-domain.example.com
